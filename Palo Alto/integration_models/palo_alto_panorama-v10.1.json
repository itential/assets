            "schema": {
              "type": "string"
            }
          },
          {
            "name": "device-group",
            "in": "query",
            "description": "Device group name. Required when location is device-group.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by rule name.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
