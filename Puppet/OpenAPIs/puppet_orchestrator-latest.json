{
  "openapi": "3.0.0",
  "info": {
    "title": "Puppet Enterprise Orchestrator",
    "description": "Orchestrator API for Puppet Enterprise -- runs Puppet agent deploys, tasks, and plans on demand across node inventory, and tracks job state and results. Rooted at /orchestrator/v1 on the primary server, port 8143.",
    "version": "latest",
    "x-vendor-api-version": "v1",
    "x-itential-curated": "Trimmed to 15 of 17 upstream operations covering job/task/plan orchestration, job monitoring, and node reachability. See the repo README for the full scope and the full spec."
  },
  "servers": [
    {
      "url": "https://{host}:8143",
      "description": "Puppet Enterprise primary server, orchestrator service. Base path /orchestrator/v1 is set via the integration instance's base_path, not baked into this URL.",
      "variables": {
        "host": {
          "default": "puppet.example.com",
          "description": "Puppet Enterprise primary server hostname."
        }
      }
    }
  ],
  "security": [
    {
      "puppetAuthToken": []
    }
  ],
  "paths": {
    "/command/deploy": {
      "post": {
        "tags": [
          "command"
        ],
        "operationId": "commandDeploy",
        "summary": "Run Puppet on demand",
        "description": "Starts a Puppet agent run (a \"deploy\" job) against the nodes, query, or node group in scope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "environment"
                ],
                "properties": {
                  "environment": {
                    "type": "string",
                    "description": "Environment name, or empty string if enforce_environment is false."
                  },
                  "scope": {
                    "type": "object",
                    "description": "Exactly one of nodes, query, or node_group.",
                    "properties": {
                      "nodes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "query": {
                        "type": "string",
                        "description": "A PuppetDB PQL query string."
                      },
                      "node_group": {
                        "type": "string",
                        "description": "A node classifier group ID."
                      }
                    }
                  },
                  "description": {
                    "type": "string"
                  },
                  "concurrency": {
                    "type": "integer",
                    "description": "Maximum number of nodes to run simultaneously."
                  },
                  "noop": {
                    "type": "boolean",
                    "default": false
                  },
                  "debug": {
                    "type": "boolean"
                  },
                  "trace": {
                    "type": "boolean"
                  },
                  "enforce_environment": {
                    "type": "boolean"
                  },
                  "userdata": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "environment": "production",
                "scope": {
                  "nodes": [
                    "node1.example.com",
                    "node2.example.com"
                  ]
                },
                "description": "Deploy production",
                "concurrency": 10,
                "noop": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "job": {
                    "id": "https://orchestrator.example.com:8143/orchestrator/v1/jobs/81",
                    "name": "81"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/command/task": {
      "post": {
        "tags": [
          "command"
        ],
        "operationId": "commandTask",
        "summary": "Run a task on a set of nodes",
        "description": "Starts a task run job against the nodes, query, or node group in scope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task",
                  "params",
                  "scope"
                ],
                "properties": {
                  "environment": {
                    "type": "string",
                    "default": "production"
                  },
                  "task": {
                    "type": "string",
                    "description": "Task name, e.g. package::install."
                  },
                  "params": {
                    "type": "object",
                    "description": "Task parameters. Use {} if the task takes none."
                  },
                  "scope": {
                    "type": "object",
                    "description": "Exactly one of nodes, query, or node_group.",
                    "properties": {
                      "nodes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "query": {
                        "type": "string",
                        "description": "A PuppetDB PQL query string."
                      },
                      "node_group": {
                        "type": "string",
                        "description": "A node classifier group ID."
                      }
                    }
                  },
                  "description": {
                    "type": "string"
                  },
                  "noop": {
                    "type": "boolean",
                    "default": false
                  },
                  "timeout": {
                    "type": "integer",
                    "description": "Maximum seconds allowed per node."
                  },
                  "userdata": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "environment": "production",
                "task": "package",
                "params": {
                  "action": "status",
                  "name": "httpd"
                },
                "scope": {
                  "nodes": [
                    "node1.example.com"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/command/plan_run": {
      "post": {
        "tags": [
          "command"
        ],
        "operationId": "commandPlanRun",
        "summary": "Run a plan",
        "description": "Starts a plan run job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan_name"
                ],
                "properties": {
                  "plan_name": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  },
                  "environment": {
                    "type": "string",
                    "default": "production"
                  },
                  "description": {
                    "type": "string"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "userdata": {
                    "type": "object"
                  }
                }
              },
              "example": {
                "plan_name": "canary",
                "description": "Start the canary plan on node1 and node2",
                "params": {
                  "nodes": [
                    "node1.example.com",
                    "node2.example.com"
                  ],
                  "command": "whoami",
                  "canary": 1
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Job ID, usable with /command/stop_plan."
                    }
                  }
                },
                "example": {
                  "name": "1234"
                }
              }
            }
          }
        }
      }
    },
    "/command/stop": {
      "post": {
        "tags": [
          "command"
        ],
        "operationId": "commandStop",
        "summary": "Stop a running job",
        "description": "Halts an in-progress deploy or task job. By default lets in-progress node runs finish; set force to true to terminate immediately.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "job"
                ],
                "properties": {
                  "job": {
                    "type": "string",
                    "description": "Job ID to stop."
                  },
                  "force": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "example": {
                "job": "1234"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Stop accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "nodes": {
                          "type": "object",
                          "properties": {
                            "new": {
                              "type": "integer"
                            },
                            "running": {
                              "type": "integer"
                            },
                            "failed": {
                              "type": "integer"
                            },
                            "errored": {
                              "type": "integer"
                            },
                            "skipped": {
                              "type": "integer"
                            },
                            "finished": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/command/stop_plan": {
      "post": {
        "tags": [
          "command"
        ],
        "operationId": "commandStopPlan",
        "summary": "Stop a running plan job",
        "description": "Halts an in-progress plan job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "job"
                ],
                "properties": {
                  "job": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "job": "1234"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Stop accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "operationId": "getJobs",
        "summary": "List jobs",
        "description": "Returns a paginated list of jobs and their details.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "owner",
                "timestamp",
                "environment",
                "name",
                "state"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "deploy",
                "task",
                "plan_task"
              ]
            }
          },
          {
            "name": "task",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Match task name (partial match supported)."
          },
          {
            "name": "min_finish_timestamp",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_finish_timestamp",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of jobs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Full URL of the job resource."
                          },
                          "name": {
                            "type": "string",
                            "description": "Job ID."
                          },
                          "state": {
                            "type": "string",
                            "description": "new, ready, running, stopping, stopped, finished, or failed."
                          },
                          "command": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "description": "deploy, task, plan_task, plan_script, plan_upload, plan_command, plan_wait, plan_apply, or plan_apply_prep."
                          },
                          "owner": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "login": {
                                "type": "string"
                              }
                            }
                          },
                          "timestamp": {
                            "type": "string"
                          },
                          "started_timestamp": {
                            "type": "string"
                          },
                          "finished_timestamp": {
                            "type": "string"
                          },
                          "duration": {
                            "type": "string"
                          },
                          "node_count": {
                            "type": "integer"
                          },
                          "node_states": {
                            "type": "object"
                          },
                          "nodes": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              }
                            }
                          },
                          "report": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              }
                            }
                          },
                          "events": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              }
                            }
                          },
                          "userdata": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "order_by": {
                          "type": "string"
                        },
                        "order": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
