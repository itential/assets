      "WorkspaceRequest": {
        "type": "string",
        "enum": [
          "REQUEST_UNSPECIFIED",
          "REQUEST_START_BUILD",
          "REQUEST_CANCEL_BUILD",
          "REQUEST_SUBMIT",
          "REQUEST_ABANDON",
          "REQUEST_ROLLBACK",
          "REQUEST_SUBMIT_FORCE",
          "REQUEST_REBASE"
        ],
        "description": "Asynchronous operation to kick off on the workspace. REQUEST_START_BUILD compiles and validates the workspace's changes (this single call covers build and validate). REQUEST_SUBMIT submits the workspace to the mainline, creating Change Controls as needed."
      },
      "WorkspaceRequestParams": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
