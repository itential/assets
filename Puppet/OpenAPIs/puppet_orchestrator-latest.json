    "/tasks": {
      "get": {
        "tags": [
          "tasks"
        ],
        "operationId": "getTasks",
        "summary": "List tasks",
        "description": "Returns every task installed in the given environment, including tasks bundled with Itential Gateway-adjacent PE modules.",
        "parameters": [
          {
            "name": "environment",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "production"
            }
          }
        ],
        "responses": {
          "200": {
