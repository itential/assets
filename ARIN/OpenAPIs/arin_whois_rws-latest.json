  "components": {
    "schemas": {
      "PocsSearchResults": {
        "type": "object",
        "properties": {
          "pocs": {
            "type": "object",
            "properties": {
              "pocRef": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "A single search-result reference (XML-derived JSON). ARIN's raw JSON key for the record URL is a literal '$', which Itential Platform can't store as-is and renames inconsistently (seen as both 'dollarSign$' and 'dollarSign*') -- check the raw response if the 'url' field below doesn't match what you see.",
                  "properties": {
                    "@handle": {
                      "type": "string"
                    },
                    "@name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "description": "URL to the full record. Corresponds to ARIN's raw '$' JSON key."
                    }
                  }
                }
              },
              "limitExceeded": {
                "type": "object",
                "properties": {
                  "@limit": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
