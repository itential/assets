    "/api": {
      "get": {
        "operationId": "commitChanges",
        "summary": "Commit Changes",
        "description": "Commit pending configuration changes to Panorama via the XML API.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "API request type. Set to 'commit' for committing changes.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "commit"
            }
          },
          {
            "name": "cmd",
            "in": "query",
            "description": "XML command to execute.",
            "required": true,
            "schema": {
              "type": "string",
              "default": "<commit></commit>"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "post": {
        "operationId": "postXML",
        "summary": "Post XML Command",
        "description": "Execute an operational command on a managed device via the Panorama XML API.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "API request type (e.g. op, commit, config).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cmd",
            "in": "query",
            "description": "XML command string to execute.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target",
            "in": "query",
            "description": "Serial number of the target managed device.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
