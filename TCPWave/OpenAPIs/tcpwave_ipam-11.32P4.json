              }
            }
          }
        }
      }
    },
    "/zone/list": {
      "get": {
        "summary": "List DNS Zones",
        "description": "Lists DNS zones defined in an organization.",
        "operationId": "listZones",
        "tags": [
          "DNS Zones & Records"
        ],
        "responses": {
          "200": {
            "description": "Array of zone objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "organization_name",
