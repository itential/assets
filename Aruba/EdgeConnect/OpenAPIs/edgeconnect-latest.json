{
  "openapi": "3.0.3",
  "info": {
    "title": "HPE Aruba Networking EdgeConnect SD-WAN",
    "version": "latest",
    "x-vendor-api-version": "9.5",
    "description": "HPE Aruba Networking EdgeConnect SD-WAN Orchestrator centrally manages EdgeConnect appliances, Business Intent Overlays, and tunnels across a WAN fabric.\n\nAuthentication: static API key in the X-Auth-Token header.",
    "x-itential-curated": "Trimmed to 26 of 154 upstream operations covering appliance management, discovery/approval, appliance groups, Business Intent Overlays, tunnel visibility, and template group configuration. See the repo README for the full scope and the full spec."
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "HPE Aruba Networking EdgeConnect SD-WAN Orchestrator server. This platform does not apply OpenAPI server variables/paths automatically \u2014 set the integration instance's server.base_path to \"/gms/rest\".",
      "variables": {
        "protocol": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ],
          "description": "HTTP scheme"
        },
        "host": {
          "default": "orchestrator.example.com",
          "description": "Orchestrator hostname or IP address."
        },
        "port": {
          "default": "443",
          "description": "Orchestrator port."
        }
      }
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "tags": [
    {
      "name": "Appliances"
    },
    {
