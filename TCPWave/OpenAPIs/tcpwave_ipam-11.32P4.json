            }
          }
        }
      }
    },
    "/zone/update": {
      "post": {
        "summary": "Update DNS Zone",
        "description": "Updates a DNS zone's configuration and/or its resource records (via addedRRs/deletedRRs).",
        "operationId": "updateZone",
        "tags": [
          "DNS Zones & Records"
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
