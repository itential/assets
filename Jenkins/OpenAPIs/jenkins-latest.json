  "components": {
    "securitySchemes": {
      "jenkins_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Label1": {
        "type": "object",
        "properties": {
          "_class": {
            "type": "string"
          }
        }
      },
      "CauseUserIdCause": {
        "type": "object",
        "properties": {
          "_class": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string"
          },
