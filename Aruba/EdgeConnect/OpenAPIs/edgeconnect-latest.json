  "paths": {
    "/appliance": {
      "get": {
        "tags": [
          "Appliances"
        ],
        "summary": "List appliances",
        "operationId": "listAppliances",
        "description": "Returns all appliances managed by Orchestrator. Pass nePk to return a single appliance.",
        "parameters": [
          {
            "name": "nePk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Network Primary Key of a single appliance, e.g. 3.NE."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Appliance"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/appliance/{nePk}": {
      "post": {
        "tags": [
          "Appliances"
        ],
        "summary": "Modify an appliance",
        "operationId": "modifyAppliance",
        "description": "Updates an appliance's IP address, username, password, network role, and web protocol.",
        "parameters": [
          {
            "name": "nePk",
            "in": "path",
            "required": true,
            "schema": {
