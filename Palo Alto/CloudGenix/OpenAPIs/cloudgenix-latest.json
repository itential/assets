{
  "openapi": "3.0.3",
  "info": {
    "title": "CloudGenix",
    "version": "latest",
    "description": "CloudGenix (now Palo Alto Networks Prisma SD-WAN) provides centralized configuration and monitoring for SD-WAN appliances (ION devices), sites, and tenants via a REST API on the CloudGenix cloud controller.\n\nAuthentication: static API token (generated in the UI) sent in the x-auth-token header. No login/session exchange.",
    "x-vendor-api-version": "1.0",
    "x-itential-curated": "Reviewed against the repo's common-CRUD-for-automation policy: all 31 upstream operations (read and create only, across Elements, Firewall, Network, Policy, Site, and Tenant) are already in scope, so the full spec is carried through as -latest. See the repo README for the operation breakdown and the full spec."
  },
  "servers": [
    {
      "url": "https://api.{region}.cloudgenix.com",
      "description": "CloudGenix/Prisma SD-WAN regional controller API",
      "variables": {
        "region": {
          "default": "sase",
          "description": "Tenant's controller region subdomain, e.g. sase, sasecanada, sase-anz"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "staticAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-auth-token",
        "description": "Static auth token generated in the CloudGenix/Prisma SD-WAN UI under System > Access Management > Site Access > Auth Tokens, replayed as-is on every request. No login/session exchange."
      }
    }
  },
  "security": [
    {
      "staticAuthToken": []
    }
  ],
