{
  "openapi": "3.0.3",
  "info": {
    "title": "OWASP ZAP",
    "description": "Authentication: static API key. The HTTP API for controlling and automating the OWASP Zed Attack Proxy (ZAP), the open-source web application security scanner. Covers spider and active scan job control, alerts, context/scope management, and core session operations.",
    "version": "latest",
    "x-vendor-api-version": "2.16.1",
    "x-itential-curated": "Trimmed to 33 of 735 upstream operations covering common CRUD for automation: spider scan job control, active scan job control, alerts, context/scope management, and core session/site/URL operations. See the repo README for the full scope and the full spec.",
    "contact": {
      "name": "ZAP User Group",
      "url": "https://groups.google.com/group/zaproxy-users"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "OWASP ZAP API server. This platform does not apply OpenAPI server variables/paths automatically \u2014 set the integration instance's server.base_path to \"\" (all curated operations already include their full /JSON/... path).",
      "variables": {
        "protocol": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "default": "127.0.0.1",
          "description": "Host ZAP is listening on (no protocol, no path)."
        },
        "port": {
          "default": "8080"
        }
      }
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "tags": [
    {
      "name": "spider",
      "description": "Traditional spider crawl job control."
    },
    {
      "name": "ascan",
      "description": "Active scan job control."
    },
    {
      "name": "alert",
      "description": "Alerts raised by passive and active scanning."
    },
    {
      "name": "context",
      "description": "Context (scope) management."
    },
    {
      "name": "core",
      "description": "Core session, site, and URL operations."
    }
  ],
  "paths": {
    "/JSON/spider/action/scan/": {
      "get": {
        "operationId": "spiderActionScan",
        "summary": "Start Spider Scan",
        "description": "Starts crawling the target site with the Spider tool, optionally against a specific context.",
        "tags": [
          "spider"
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target URL to start the spider scan from."
          },
          {
            "name": "maxChildren",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Maximum number of child URLs to crawl per node."
          },
          {
            "name": "recurse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Whether the spider should crawl recursively."
          },
          {
            "name": "contextName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Context to constrain the scan to."
          },
          {
            "name": "subtreeOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Whether to constrain the scan to URLs under the start URL's subtree."
          }
        ],
        "responses": {
          "200": {
            "description": "The ID of the newly started spider scan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanId"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorJson"
          }
        }
      }
    },
    "/JSON/spider/view/status/": {
      "get": {
        "operationId": "spiderViewStatus",
        "summary": "Get Spider Scan Status",
        "description": "Returns the percentage complete for a spider scan, or for all spider scans if scanId is omitted.",
        "tags": [
          "spider"
        ],
        "parameters": [
          {
            "name": "scanId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the spider scan. Omit for the status of the most recent scan."
          }
        ],
        "responses": {
          "200": {
            "description": "Percentage complete (0-100).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorJson"
          }
        }
      }
    },
    "/JSON/spider/action/stop/": {
      "get": {
        "operationId": "spiderActionStop",
        "summary": "Stop Spider Scan",
        "description": "Stops a running spider scan, or all spider scans if scanId is omitted.",
        "tags": [
          "spider"
        ],
        "parameters": [
          {
            "name": "scanId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the spider scan to stop. Omit to stop all spider scans."
          }
        ],
        "responses": {
          "200": {
            "description": "Action completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Result": {
                      "type": "string",
                      "example": "OK"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorJson"
          }
        }
      }
    },
