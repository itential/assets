{
  "openapi": "3.0.3",
  "info": {
    "title": "Spirent TestCenter",
    "version": "1.0",
    "description": "Spirent TestCenter is a network test and measurement platform for validating device, network, and security performance at scale. The STC REST API exposes its Tcl/Python automation object model (sessions, test objects, chassis connections, and command execution) over HTTP.\n\nAuthentication: static session-token header (X-STC-API-Session). No login/token exchange."
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}/stcapi",
      "description": "STC REST API server (Spirent Lab Server or standalone STC REST daemon)",
      "variables": {
        "protocol": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ]
        },
        "host": {
          "default": "labserver.example.com",
          "description": "Lab Server or REST daemon host (no protocol, no path)"
        },
        "port": {
          "default": "8888"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "staticSessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-STC-API-Session",
        "description": "Static session-token header. The STC REST API server issues this token when the lab server process starts; it is configured once as a static credential on the Itential integration instance rather than exchanged via a login call."
      }
    }
  },
  "security": [
    {
      "staticSessionToken": []
    }
  ],
