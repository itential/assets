    "/JSON/ascan/action/scan/": {
      "get": {
        "operationId": "ascanActionScan",
        "summary": "Start Active Scan",
        "description": "Starts an Active Scan against the target, optionally through a defined Scan Policy.",
        "tags": [
          "ascan"
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target URL to start the active scan from."
          },
          {
            "name": "recurse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Whether the scan should also apply to URLs under the target URL."
          },
          {
            "name": "inScopeOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Whether to only scan URLs in scope."
          },
          {
            "name": "scanPolicyName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Scan policy to use instead of the default policy."
          },
          {
            "name": "method",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "HTTP method to use for the initial request."
          },
          {
            "name": "postData",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "POST data to use for the initial request."
          },
          {
            "name": "contextId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Context ID to scan within."
          }
        ],
        "responses": {
          "200": {
            "description": "The ID of the newly started active scan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanId"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorJson"
          }
        }
      }
    },
