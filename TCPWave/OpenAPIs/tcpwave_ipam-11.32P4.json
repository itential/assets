          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size.",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 25
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TIMSSessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "TIMS-Session-Token",
        "description": "Long-lived (default 60-day) session token generated out-of-band from the TCPWave IPAM UI (Administration > Security Management > Session Token Management). Replayed as a static header value on every request; there is no token-exchange call in this API."
      }
    },
    "schemas": {
      "NetworkAddRequest": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "Network base address.",
            "example": "10.1.10.0"
          },
          "mask_length": {
            "type": "string",
            "example": "16"
          },
          "name": {
            "type": "string",
            "example": "test"
          },
          "description": {
            "type": "string"
          },
          "dmzVisible": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          },
          "dnssec_enable": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          },
          "nsec_option": {
            "type": "string",
            "enum": [
              "NSEC",
              "NSEC3"
            ]
          },
          "percentageFull": {
            "type": "integer",
            "description": "Utilization threshold percentage."
          },
          "email_check": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "snmp_check": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "log_check": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "rrs": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A single DNS resource record.",
              "properties": {
                "owner": {
                  "type": "string",
                  "description": "Fully-qualified owner name, e.g. www.tcpwave.com.",
                  "example": "www.tcpwave.com."
                },
                "rrclass": {
                  "type": "string",
                  "example": "IN"
                },
                "rrtype": {
                  "type": "string",
                  "description": "Resource record type.",
                  "example": "A",
                  "enum": [
                    "A",
                    "AAAA",
                    "CNAME",
                    "MX",
                    "NS",
                    "TXT",
                    "PTR",
                    "SRV"
                  ]
                },
                "ttl": {
                  "type": "string",
                  "example": "1200"
                },
                "data": {
                  "type": "string",
                  "description": "Record data, e.g. an IP address for an A record or a priority+target for MX.",
                  "example": "10.1.10.5"
                },
                "status": {
                  "type": "integer",
                  "example": 1
                },
                "description": {
                  "type": "string"
                },
                "is_external_rr": {
                  "type": "integer",
                  "enum": [
                    0,
                    1
                  ]
                }
              },
              "required": [
                "owner",
                "rrtype",
                "data"
              ]
            }
          },
          "zoneTemplateId": {
            "type": "string"
          },
          "zoneTemplateName": {
            "type": "string",
            "nullable": true
          },
          "addr1": {
            "type": "string",
            "example": "10"
          },
          "addr2": {
            "type": "string",
            "example": "1"
          },
          "addr3": {
            "type": "string",
            "example": "10"
          },
          "addr4": {
            "type": "string",
            "example": "0"
          },
          "organization_name": {
            "type": "string",
            "description": "Name of the TCPWave organization (tenant) the resource belongs to.",
            "example": "EARTH"
          }
        },
        "required": [
          "address",
          "mask_length",
          "name",
          "organization_name"
        ]
      },
      "NetworkDeleteRequest": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "example": "10.1.10.0"
          },
          "organization_name": {
            "type": "string",
            "description": "Name of the TCPWave organization (tenant) the resource belongs to.",
            "example": "EARTH"
          }
        },
        "required": [
          "address",
          "organization_name"
        ]
      },
      "SubnetAddRequest": {
        "type": "object",
        "properties": {
          "addr1": {
            "type": "integer",
            "example": 10
          },
          "addr2": {
            "type": "integer",
            "example": 1
          },
          "addr3": {
            "type": "integer",
            "example": 10
          },
          "addr4": {
            "type": "integer",
            "example": 0
          },
          "mask_length": {
            "type": "integer",
            "example": 24
          },
          "name": {
            "type": "string",
            "example": "Demo Subnet 1"
          },
          "routerAddress": {
            "type": "string",
            "example": "10.1.10.1"
          },
          "network_address": {
            "type": "string",
            "description": "Parent network address this subnet belongs to.",
            "example": "10.1.10.0"
          },
          "primary_domain": {
            "type": "string",
            "example": "tcpwave.com"
          },
          "organization_name": {
            "type": "string",
            "description": "Name of the TCPWave organization (tenant) the resource belongs to.",
            "example": "EARTH"
          }
        },
        "required": [
          "addr1",
          "addr2",
          "addr3",
          "addr4",
          "mask_length",
          "name",
          "network_address",
          "organization_name"
        ]
      },
      "SubnetUpdateRequest": {
        "type": "object",
        "properties": {
          "address": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subnet address(es) being edited.",
            "example": [
              "10.1.10.0"
            ]
          },
          "subnet": {
            "type": "object",
            "properties": {
              "name": {
