  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Token",
        "description": "Static API key generated in Orchestrator (Orchestrator > Users & Authentication > API Keys). Session/cookie-based login is deprecated as of Orchestrator 9.3 (API v200) and is not used by this spec."
      }
    },
    "schemas": {
      "Appliance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Network Primary Key (nePk) of the appliance, e.g. 3.NE."
          },
          "nePk": {
            "type": "string",
            "description": "Same value as id."
          },
          "hostName": {
            "type": "string"
          },
          "IP": {
            "type": "string"
          },
          "networkRole": {
            "type": "string",
            "description": "spoke = 0, hub = 1, mesh = 2"
          },
          "site": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "description": "Primary key of the Orchestrator group the appliance belongs to."
          },
          "model": {
            "type": "string"
          },
          "serial": {
            "type": "string"
          },
          "softwareVersion": {
            "type": "string"
          },
          "state": {
            "type": "integer",
            "description": "0=Unknown, 1=Normal, 2=Unreachable, 3=Unsupported Version, 4=Out of Synchronization, 5=Synchronization in Progress"
          },
          "bypass": {
            "type": "boolean"
          },
          "hasUnsavedChanges": {
            "type": "boolean"
          },
          "rebootRequired": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "ApplianceModify": {
        "type": "object",
        "required": [
          "userName",
          "password",
          "IP",
          "webProtocolType",
          "networkRole"
        ],
        "properties": {
          "userName": {
            "type": "string",
            "description": "Username for Orchestrator to log on to this appliance."
          },
          "password": {
            "type": "string"
          },
          "IP": {
            "type": "string"
          },
          "webProtocolType": {
            "type": "integer",
            "description": "Http = 1, Https = 2, Both = 3"
          },
          "networkRole": {
            "type": "string",
            "description": "spoke = 0, hub = 1, mesh = 2"
          }
        }
      },
      "ChangeApplianceGroup": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of appliance nePk values to move, e.g. [\"3.NE\",\"5.NE\"]."
          }
        }
      },
      "DiscoveredApplianceApproval": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Primary key of the Orchestrator group to add the appliance to, e.g. 4.Network."
          },
          "latitude": {
            "type": "number",
            "default": 0
          },
          "longitude": {
            "type": "number",
            "default": 0
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Group Primary Key, e.g. 3.Network."
          },
          "name": {
            "type": "string"
          },
          "subType": {
            "type": "integer",
            "description": "Root group = 0, auto-discovered = 2, user-defined = 3."
          },
          "parentId": {
            "type": "string"
          },
          "backgroundImage": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "GroupCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique group name."
          },
          "parentId": {
            "type": "string",
            "description": "Parent group primary key, e.g. 3.Network. Empty string targets the root group."
          },
          "backgroundImage": {
            "type": "string"
          }
        }
      },
      "GroupUpdate": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Group primary key being updated, e.g. 3.Network."
          },
          "name": {
            "type": "string"
          },
          "backgroundImage": {
            "type": "string"
          }
        }
      },
      "OverlayConfig": {
        "type": "object",
        "description": "Business Intent Overlay configuration object. See the Orchestrator's own Swagger UI (Support > REST APIs) for the full nested schema \u2014 traffic behavior, member appliances, and per-region overrides are all vendor-defined nested structures.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Numeric overlay ID (read-only, assigned on create)."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "TemplateGroup": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the configuration templates selected in this group."
          }
        },
        "additionalProperties": true
      },
      "TemplateGroupCreate": {
