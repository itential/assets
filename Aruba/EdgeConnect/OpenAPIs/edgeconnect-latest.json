          }
        }
      },
      "delete": {
        "tags": [
          "Appliances"
        ],
        "summary": "Delete an appliance",
        "operationId": "deleteAppliance",
        "description": "Removes an appliance from Orchestrator, including its Orchestrator account/key.",
