  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "apiKey",
        "description": "Static, instance-generated API key. Create one in Incident Management under Settings > API Key Management, then pass it verbatim as the apiKey header value."
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "description": "A single monitoring event submitted for correlation.",
        "properties": {
          "source": {
            "type": "string",
            "description": "Originating system/device name."
          },
          "class": {
            "type": "string",
            "description": "Event class, e.g. the monitored metric or check name."
          },
          "type": {
            "type": "string",
            "description": "Event type, e.g. the monitoring tool that generated it."
          },
          "severity": {
            "type": "integer",
            "description": "Severity, 0 (clear) - 5 (critical)."
          },
          "description": {
            "type": "string",
            "description": "Human-readable event description."
          },
          "manager": {
            "type": "string",
            "description": "Name of the system managing/forwarding this event."
          },
          "agent": {
            "type": "string",
            "description": "Name of the agent/collector that produced the event."
          },
          "agentLocation": {
            "type": "string",
            "description": "Location of the agent that produced the event."
          },
          "signature": {
            "type": "string",
            "description": "Deduplication signature; matching events are folded into the same alert."
          }
        },
        "required": [
          "source",
          "class",
          "type",
          "severity",
          "description"
        ]
      },
      "EventBatch": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": [
          "events"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Alert ID."
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "description": "Alert status, e.g. open/acknowledged/closed."
          },
          "source": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "description": "User the alert is assigned to."
          },
          "firstEventTime": {
            "type": "string",
            "format": "date-time"
          },
          "lastEventTime": {
            "type": "string",
            "format": "date-time"
          },
          "count": {
            "type": "integer",
            "description": "Number of deduplicated events folded into this alert."
          },
          "incidentId": {
            "type": "string",
            "description": "ID of the incident this alert has been correlated into, if any."
          }
        }
      },
      "AlertUpdate": {
        "type": "object",
        "description": "Alerts are largely read-only; only owner and status can be updated.",
        "properties": {
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "assignee": {
            "type": "string"
          },
          "alertCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IncidentUpdate": {
        "type": "object",
        "properties": {
          "assignee": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          }
        }
      },
      "IncidentComment": {
        "type": "object",
        "properties": {
          "comment": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "comment"
        ]
      },
      "Catalog": {
        "type": "object",
        "description": "A data enrichment lookup table used to add fields to events/alerts based on matching keys.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "keyFields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields used to match incoming events/alerts against catalog rows."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Catalog rows."
          }
        },
        "required": [
          "name"
        ]
      },
      "MaintenanceWindow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "recurrence": {
            "type": "string",
            "description": "Recurrence rule, e.g. none/daily/weekly/monthly."
          },
          "filter": {
            "type": "string",
            "description": "Filter expression selecting which alerts/events this window suppresses."
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "startTime",
          "endTime"
        ]
      },
      "CorrelationDefinition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "algorithm": {
            "type": "string",
            "description": "Correlation algorithm, e.g. similarity/topology/time-window."
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "Algorithm-specific tuning parameters."
          }
        },
        "required": [
          "name",
          "algorithm"
        ]
      },
      "Workflow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "trigger": {
            "type": "string",
            "description": "Condition that starts the workflow, e.g. an alert/incident filter."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Ordered list of workflow actions."
          }
        }
      },
      "WorkflowUpdate": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Collector": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "description": "OS/platform the collector is installed on."
          },
          "status": {
            "type": "string",
            "description": "Connectivity status, e.g. online/offline."
          },
          "version": {
            "type": "string"
          },
          "lastCheckIn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "integer"
          }
        }
      }
    }
  }
}
