  "info": {
    "title": "Palo Alto Panorama",
    "description": "Palo Alto Panorama REST API and XML API for managing security policy rules and committing configuration changes.\n\nAuthentication: API key passed via the X-PAN-KEY request header. Generate an API key from Panorama under Device \u2192 Administrators or via the XML API keygen endpoint.\n\nSource: https://docs.paloaltonetworks.com/pan-os/10-1/pan-os-panorama-api",
    "version": "v10.1"
  },
  "externalDocs": {
    "url": ""
