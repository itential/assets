            }
          },
          {
            "name": "organization_name",
            "in": "query",
            "description": "Organization the zone belongs to.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EARTH"
            }
          }
        ]
      }
    },
    "/scope/create": {
      "post": {
        "summary": "Create DHCP Scope",
        "description": "Creates a DHCP scope (address ranges plus options) inside a subnet.",
        "operationId": "createDhcpScope",
        "tags": [
          "DHCP Scopes"
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DhcpScopeCreateRequest"
              }
            }
          }
