{
  "openapi": "3.0.3",
  "info": {
    "title": "TCPWave IPAM",
    "version": "11.32P4",
    "description": "Authentication: API key (TIMS-Session-Token header). TCPWave IPAM is a DNS-DHCP-IPAM (DDI) management platform. This API covers core IP address space management: networks, subnets, IP objects (host records), DNS zones and resource records, and DHCP scopes.",
    "contact": {
      "name": "TCPWave",
      "url": "https://www.tcpwave.com/"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "TCPWave IPAM management appliance. The REST API is served under a base path (default /tims/rest) configured via this instance's base_path property, not encoded in this URL.",
      "variables": {
        "protocol": {
          "default": "https"
        },
        "host": {
          "default": "tcpwave.example.com"
        },
        "port": {
          "default": "7443"
        }
      }
    }
  ],
  "security": [
    {
      "TIMSSessionToken": []
    }
  ],
  "tags": [
    {
      "name": "Networks"
    },
    {
      "name": "Subnets"
    },
    {
      "name": "IP Addresses"
    },
    {
      "name": "DNS Zones & Records"
    },
    {
      "name": "DHCP Scopes"
    }
  ],
  "paths": {
    "/network/add": {
      "post": {
        "summary": "Create Network",
        "description": "Creates a network (address block) inside a TCPWave organization.",
        "operationId": "createNetwork",
        "tags": [
          "Networks"
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NetworkAddRequest"
              }
            }
          }
        }
      }
    },
    "/network/delete": {
      "post": {
        "summary": "Delete Network",
        "description": "Deletes a network by its base address.",
        "operationId": "deleteNetwork",
        "tags": [
          "Networks"
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NetworkDeleteRequest"
              }
            }
          }
        }
      }
    },
    "/network/list": {
      "get": {
        "summary": "List Networks",
        "description": "Lists networks defined in an organization.",
        "operationId": "listNetworks",
        "tags": [
          "Networks"
        ],
        "responses": {
          "200": {
            "description": "Array of network objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "organization_name",
            "in": "query",
            "description": "Organization to list networks for.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EARTH"
            }
          }
        ]
      }
    },
    "/network/getnetworkdetailsbyip": {
      "get": {
        "summary": "Get Network Details by IP",
        "description": "Returns the network that contains the given IP address.",
        "operationId": "getNetworkDetailsByIp",
        "tags": [
