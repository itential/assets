  "paths": {
    "/workflows": {
      "get": {
        "operationId": "listWorkflows",
        "summary": "List/find workflows",
        "description": "Lists workflows in the inventory. Use the conditions query parameter to find a workflow by full name (name={value}) or by keyword (name~{value}).",
        "parameters": [
          {
            "name": "conditions",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter expression, e.g. name={workflowFullName} or name~{keyword}."
          },
          {
            "name": "maxResult",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startIndex",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching workflows.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedList"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/{id}": {
      "get": {
        "operationId": "getWorkflow",
        "summary": "Get workflow definition",
        "description": "Retrieves a workflow's definition, including its input/output parameters and links to its available runs and input form schema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow definition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workflow"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/{id}/executions": {
      "post": {
        "operationId": "runWorkflow",
        "summary": "Run a workflow",
        "description": "Starts a new execution of the workflow. Provide input parameter values in the execution-context of the request body; an empty execution-context runs the workflow with its default parameter values, where available. Returns 202 Accepted with a Location header pointing to the new execution.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionContext"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Execution accepted."
          }
        }
      },
      "get": {
        "operationId": "listWorkflowExecutions",
        "summary": "List workflow runs",
        "description": "Lists the available execution (run) instances of the workflow, with their start/end dates, status, and initiator.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxResult",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startIndex",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of workflow runs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedList"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/{id}/executions/{executionId}": {
      "get": {
        "operationId": "getWorkflowExecution",
        "summary": "Get a workflow run",
        "description": "Retrieves a particular workflow run's input parameters, initiator, dates, and run state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowExecution"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/{id}/executions/{executionId}/state": {
      "get": {
        "operationId": "getWorkflowExecutionState",
        "summary": "Get a workflow run's state",
        "description": "Retrieves additional information about the state of a workflow run.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow run state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowExecutionState"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelWorkflowExecution",
        "summary": "Cancel a workflow run",
        "description": "Terminates a running workflow execution.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Workflow run canceled."
          }
        }
      }
    },
    "/workflows/{id}/executions/{executionId}/logs": {
      "get": {
        "operationId": "getWorkflowExecutionLogs",
        "summary": "Get a workflow run's logs",
        "description": "Retrieves the log messages generated during a workflow run.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow run logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowExecutionLogs"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/{id}/executions/{executionId}/interaction": {
      "post": {
        "operationId": "answerWorkflowUserInteraction",
        "summary": "Answer a waiting user interaction",
        "description": "Provides input parameter values for a workflow run that is waiting on a user interaction, in an execution-context element in the request body. Returns 204 No Content on success.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionContext"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User interaction answered."
          }
        }
      }
    },
    "/catalog/System/UserInteraction": {
      "get": {
        "operationId": "listUserInteractions",
        "summary": "List user interactions",
        "description": "Lists user interaction objects. Waiting interactions have a state variable with value waiting; filter with status=0 to return only waiting interactions.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "0 returns only waiting interactions."
          }
        ],
        "responses": {
          "200": {
            "description": "List of user interactions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkedList"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/System/UserInteraction/{id}": {
      "get": {
        "operationId": "getUserInteraction",
        "summary": "Get a user interaction",
        "description": "Retrieves a single user interaction's inventory item details.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User interaction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInteraction"
                }
              }
            }
          }
