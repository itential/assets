{
  "openapi": "3.0.3",
  "info": {
    "title": "Moogsoft Cloud",
    "description": "Moogsoft Cloud (APEX AIOps Incident Management) is a SaaS AIOps platform that ingests events, correlates them into alerts, and groups related alerts into incidents to reduce operational noise. This API supports sending and receiving alerts, incidents, and events, and configuring catalogs, maintenance windows, correlation definitions, and workflows. Base path: none -- all resources are served directly off the host at /v1 or /v2 (e.g. https://api.moogsoft.ai/v1/incidents). This is the reference spec as authored directly from Moogsoft's live documentation on 2026-09-23 (Moogsoft does not publish a downloadable OpenAPI file); it carries the same operation set as -latest.json.",
    "version": "2026-09-23",
    "contact": {
      "name": "Moogsoft Support",
      "url": "https://docs.moogsoft.com/"
    }
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "Moogsoft Cloud Incident Management API. This platform does not apply OpenAPI server variables/paths automatically -- leave the integration instance's server.base_path empty, since every resource is served directly off the host at /v1 or /v2.",
      "variables": {
        "protocol": {
          "default": "https",
          "enum": [
            "https"
          ]
        },
        "host": {
          "default": "api.moogsoft.ai",
          "description": "Moogsoft Cloud API host. Production is api.moogsoft.ai; some customers may be issued a dedicated api.dev.moogsoft.cloud development host."
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Events",
      "description": "Event ingestion."
    },
    {
      "name": "Alerts",
      "description": "Deduplicated alerts generated from ingested events."
    },
    {
      "name": "Incidents",
      "description": "Incidents formed by correlating related alerts."
    },
    {
      "name": "Catalogs",
      "description": "Data enrichment lookup tables applied to incoming events/alerts."
    },
    {
      "name": "Maintenance Windows",
      "description": "Scheduled suppression windows for known maintenance."
    },
    {
      "name": "Correlation Definitions",
      "description": "Rules the Correlation Engine uses to group alerts into incidents."
    },
    {
      "name": "Workflows",
      "description": "Workflow Engine automations triggered by alerts/incidents."
    },
    {
      "name": "Collectors",
      "description": "Collector agents that forward on-prem data into Moogsoft Cloud."
    }
  ],
