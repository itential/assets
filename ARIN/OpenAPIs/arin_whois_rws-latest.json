{
  "openapi": "3.0.0",
  "info": {
    "title": "ARIN Whois-RWS Search",
    "description": "ARIN's legacy Whois RESTful Web Service (Whois-RWS), scoped to search/list-by-criteria operations only. Get-by-identifier operations are covered by the cleaner arin_rdap-latest.json spec instead -- see that spec's README for why. Public read-only service; no authentication required.",
    "version": "latest",
    "x-itential-curated": "Scoped to only the 8 search operations that ARIN's RDAP service can't match (multi-field POC/org/net/customer search) -- every get-by-identifier operation is intentionally left to the cleaner RDAP spec instead of duplicated here with uglier XML-derived JSON. See the product README for the full rationale."
  },
  "servers": [
    {
      "url": "https://whois.arin.net"
    }
  ],
  "paths": {
    "/rest/pocs;last={lastName}": {
      "get": {
        "tags": [
          "poc"
        ],
        "operationId": "searchPocsByLastName",
        "summary": "Search POCs by last name",
        "description": "Search POCs by last name. Returns lightweight reference stubs (handle, name, URL) -- fetch the full record separately if needed.",
        "parameters": [
          {
            "name": "lastName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Point of contact last name, e.g. Smith."
          }
        ],
        "responses": {
          "200": {
            "description": "Search POCs by last name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PocsSearchResults"
                }
              }
            }
          }
        }
      }
    },
    "/rest/pocs;first={firstName}": {
      "get": {
        "tags": [
