            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCorrelationDefinition",
        "summary": "Delete correlation definition",
        "description": "Delete the correlation definition with the specified ID.",
        "tags": [
          "Correlation Definitions"
        ],
        "parameters": [
          {
            "name": "correlationDefinitionId",
            "in": "path",
            "required": true,
            "description": "Correlation definition ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Correlation definition deleted."
          },
          "default": {
            "description": "Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
