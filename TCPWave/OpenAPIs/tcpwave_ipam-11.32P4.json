            "required": true,
            "schema": {
              "type": "string",
              "example": "10.1.10.5"
            }
          },
          {
            "name": "organization_name",
            "in": "query",
            "description": "Organization to search within.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EARTH"
            }
          }
        ]
      }
    },
    "/object/add": {
