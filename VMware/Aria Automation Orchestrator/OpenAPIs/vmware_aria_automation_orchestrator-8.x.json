{
  "openapi": "3.0.3",
  "info": {
    "title": "VMware Aria Automation Orchestrator",
    "description": "Authentication: HTTP Basic (against vCenter Single Sign-On). VMware Aria Automation Orchestrator (formerly vRealize Orchestrator) is VMware's workflow automation engine, orchestrating tasks across vSphere, NSX, and other VMware and third-party systems. Its REST API exposes workflows, workflow runs, actions, categories, configurations, and packages as resources at predefined URLs.",
    "version": "8.x"
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "Automation Orchestrator server. This platform does not apply OpenAPI server variables/paths automatically -- set the integration instance's server.base_path to \"/vco/api\".",
      "variables": {
        "protocol": {
          "default": "https",
          "enum": [
            "https",
            "http"
          ]
        },
        "host": {
          "default": "orchestrator.example.com",
          "description": "Automation Orchestrator server FQDN or IP (no protocol, no path)."
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
