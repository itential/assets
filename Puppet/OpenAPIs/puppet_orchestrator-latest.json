        ],
        "operationId": "getJobReport",
        "summary": "Get job report",
        "description": "Returns the aggregate report for a finished job (resource changes, failures, and per-node summaries).",
        "parameters": [
          {
            "name": "job-id",
            "in": "path",
            "required": true,
            "schema": {
